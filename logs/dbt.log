nullif(
trim(cast(nombre as varchar)),
''
) as nombre,
nullif(
trim(cast(direccion as varchar)),
''
) as direccion,
nullif(
trim(cast(cp as varchar)),
''
) as cp
from archivo_csv
)
select
*
from estandarizado_minimo
    );
  
  
